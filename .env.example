# ============================================================
# AI Property Video Generator — Environment Configuration
# ============================================================
# Copy this file to .env and customize as needed.
# The application works fully without any API keys using 
# the deterministic template generator and edge-tts.

# --- LLM Configuration ---
# Provider options: "template" (default, no key needed), "gemini", "openai", "groq"
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# --- Text-to-Speech ---
# Provider: "edge_tts" (default, free, no key needed), "none"
TTS_PROVIDER=edge_tts
TTS_VOICE_EN=en-US-ChristopherNeural
TTS_VOICE_IN=en-IN-PrabhatNeural

# --- FFmpeg ---
# Leave blank to auto-detect from PATH or imageio-ffmpeg package
FFMPEG_PATH=

# --- Server ---
HOST=0.0.0.0
PORT=8000
